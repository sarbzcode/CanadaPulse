canadapulse:
  target: local
  outputs:
    local:
      type: postgres
      host: "{{ env_var('DBT_HOST', 'localhost') }}"
      port: "{{ env_var('DBT_PORT', '55432') | int }}"
      user: "{{ env_var('DBT_USER', 'canadapulse') }}"
      password: "{{ env_var('DBT_ENV_SECRET_PASSWORD', '') }}"
      dbname: "{{ env_var('DBT_DATABASE', 'canadapulse') }}"
      schema: analytics
      sslmode: "{{ env_var('DBT_SSLMODE', 'disable') }}"
      threads: 4
      connect_timeout: 10
      keepalives_idle: 30
