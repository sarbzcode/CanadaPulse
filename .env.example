POSTGRES_DB=canadapulse
POSTGRES_USER=canadapulse
POSTGRES_PASSWORD=canadapulse_local_password
POSTGRES_PORT=55432

CANADAPULSE_ENV=local
CANADAPULSE_LOG_LEVEL=INFO
CANADAPULSE_SERVICE_VERSION=0.1.0
CANADAPULSE_DB_HOST=localhost
CANADAPULSE_DB_PORT=55432
CANADAPULSE_DB_NAME=canadapulse
CANADAPULSE_DB_USER=canadapulse
CANADAPULSE_DB_PASSWORD=canadapulse_local_password
CANADAPULSE_DB_SSLMODE=disable
CANADAPULSE_DB_CONNECT_TIMEOUT_SECONDS=5

# Hosted PostgreSQL: uncomment and set privately; URL overrides the DB fields above.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ENVIRONMENT=local
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# FRONTEND_API_URL=https://YOUR-API-DOMAIN
